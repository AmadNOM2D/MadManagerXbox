<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Modern SDK-style UAP: TargetFramework, not the legacy TPI props -->
    <TargetFramework>uap10.0.19041</TargetFramework>
    <OutputType>WinExe</OutputType>
    <RootNamespace>MadManagerXbox</RootNamespace>
    <AssemblyName>MadManagerXbox</AssemblyName>
    <UseDotNetNativeToolchain>true</UseDotNetNativeToolchain>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="index.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\Square44x44Logo.png" />
    <Content Include="Assets\Square150x150Logo.png" />
  </ItemGroup>

</Project>
